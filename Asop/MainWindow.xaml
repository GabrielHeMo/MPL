<Window x:Class="Asop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Aspen Optimizer" Height="720" Width="1300">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra superior tipo pestañas -->
        <TabControl Grid.Row="0" Margin="0,0,0,10">

            <TabItem Header="Archivo">
                <StackPanel Orientation="Horizontal" Margin="10">
                    <Button x:Name="BtnFind"
                            Content="Find"
                            Width="70"
                            Height="28"
                            Click="BtnFind_Click"/>

                    <TextBox x:Name="TxtFilePath"
                             Width="600"
                             Height="28"
                             Margin="10,0,10,0"
                             IsReadOnly="True"/>

                    <Button x:Name="BtnClose"
                            Content="Close"
                            Width="70"
                            Height="28"
                            Click="BtnClose_Click"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Simulación">
                <StackPanel Orientation="Horizontal" Margin="10">
                    <Button x:Name="BtnRead"
                            Content="Read Aspen Tree"
                            Width="130"
                            Height="28"
                            Click="BtnRead_Click"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Variables">
                <StackPanel Orientation="Horizontal" Margin="10">
                    <Button x:Name="BtnAddSelected"
                            Content="Add Selected"
                            Width="110"
                            Height="28"
                            Click="BtnAddSelected_Click"/>

                    <Button x:Name="BtnRemoveSelected"
                            Content="Remove Selected"
                            Width="130"
                            Height="28"
                            Margin="10,0,0,0"
                            Click="BtnRemoveSelected_Click"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Objetivos">
                <StackPanel Orientation="Horizontal" Margin="10">
                    <Button x:Name="BtnAddObjective"
                            Content="Add Objective"
                            Width="120"
                            Height="28"
                            Click="BtnAddObjective_Click"/>

                    <Button x:Name="BtnRemoveObjective"
                            Content="Remove Objective"
                            Width="130"
                            Height="28"
                            Margin="10,0,0,0"
                            Click="BtnRemoveObjective_Click"/>

                    <TextBlock Text="Problem Type:"
                               VerticalAlignment="Center"
                               Margin="25,0,5,0"/>

                    <TextBlock x:Name="TxtProblemType"
                               Text="Single-objective"
                               VerticalAlignment="Center"
                               FontWeight="Bold"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Restricciones">
                <StackPanel Orientation="Horizontal" Margin="10">
                    <Button x:Name="BtnAddConstraint"
                            Content="Add Constraint"
                            Width="130"
                            Height="28"
                            Click="BtnAddConstraint_Click"/>

                    <Button x:Name="BtnRemoveConstraint"
                            Content="Remove Constraint"
                            Width="140"
                            Height="28"
                            Margin="10,0,0,0"
                            Click="BtnRemoveConstraint_Click"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Optimización">
                <StackPanel Orientation="Horizontal" Margin="10">
                    <Button x:Name="BtnRunOptimization"
                            Content="Run Optimization"
                            Width="140"
                            Height="28"/>

                    <Button x:Name="BtnStopOptimization"
                            Content="Stop"
                            Width="80"
                            Height="28"
                            Margin="10,0,0,0"/>
                </StackPanel>
            </TabItem>

        </TabControl>

        <!-- Panel principal -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="3.2*"/>
            </Grid.ColumnDefinitions>

            <!-- Aspen Tree -->
            <GroupBox Header="Aspen Tree"
                      Grid.Column="0"
                      Margin="0,0,10,0">
                <TreeView x:Name="AspenTreeView"
                          SelectedItemChanged="AspenTreeView_SelectedItemChanged"/>
            </GroupBox>

            <!-- Botones centrales -->
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="10">

                <Button x:Name="BtnAddSelectedMiddle"
                        Content="Add →"
                        Width="110"
                        Height="32"
                        Margin="0,0,0,10"
                        Click="BtnAddSelected_Click"/>

                <Button x:Name="BtnRemoveSelectedMiddle"
                        Content="← Remove"
                        Width="110"
                        Height="32"
                        Margin="0,0,0,10"
                        Click="BtnRemoveSelected_Click"/>

                <Button x:Name="BtnAddManualInput"
                        Content="Add Manual Input"
                        Width="110"
                        Height="32"
                        Margin="0,0,0,10"
                        Click="BtnAddManualInput_Click"/>

                <Button x:Name="BtnAddManualOutput"
                    Content="Add Manual Output"
                    Width="110"
                    Height="32"
                    Margin="0,0,0,10"
                    Click="BtnAddManualOutput_Click"/>
                
            </StackPanel>

            <!-- Panel derecho -->
            <TabControl Grid.Column="2">

                <!-- Inputs -->
                <TabItem Header="Input Parameters">
                    <DataGrid x:Name="InputParametersGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CellEditEnding="InputParametersGrid_CellEditEnding">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Tag"
                                                Binding="{Binding Tag}"
                                                Width="60"
                                                IsReadOnly="True"/>
                            
                            <DataGridTextColumn Header="Path"
                                                Binding="{Binding Path}"
                                                Width="*"
                                                IsReadOnly="True"/>

                            <DataGridTextColumn Header="Current Value"
                                                Binding="{Binding Value}"
                                                Width="110"
                                                IsReadOnly="True"/>

                            <DataGridComboBoxColumn Header="Variable Type"
                                                    SelectedItemBinding="{Binding VariableKind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="130">
                                <DataGridComboBoxColumn.ItemsSource>
                                    <x:Array Type="{x:Type sys:String}">
                                        <sys:String>Continuous</sys:String>
                                        <sys:String>Discrete</sys:String>
                                    </x:Array>
                                </DataGridComboBoxColumn.ItemsSource>
                            </DataGridComboBoxColumn>

                            <DataGridTextColumn Header="Lower Bound"
                                                Binding="{Binding LowerBound, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="110"/>

                            <DataGridTextColumn Header="Upper Bound"
                                                Binding="{Binding UpperBound, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="110"/>

                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- Outputs -->
                <TabItem Header="Output Variables">
                    <DataGrid x:Name="OutputObjectivesGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Tag"
                                                Binding="{Binding Tag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="120"/>

                            <DataGridTextColumn Header="Path"
                                                Binding="{Binding Path}"
                                                Width="*"
                                                IsReadOnly="True"/>

                            <DataGridTextColumn Header="Current Value"
                                                Binding="{Binding Value}"
                                                Width="120"
                                                IsReadOnly="True"/>

                            <DataGridTextColumn Header="Type"
                                                Binding="{Binding Type}"
                                                Width="90"
                                                IsReadOnly="True"/>

                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- Objective Functions -->
                <TabItem Header="Objective Functions">
                    <DataGrid x:Name="ObjectiveFunctionsGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CellEditEnding="ObjectiveFunctionsGrid_CellEditEnding">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Name"
                                                Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="120"/>

                            <DataGridTextColumn Header="Expression"
                                                Binding="{Binding Expression, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="*"/>

                            <DataGridComboBoxColumn Header="Sense"
                                                    SelectedItemBinding="{Binding Sense, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="120">
                                <DataGridComboBoxColumn.ItemsSource>
                                    <x:Array Type="{x:Type sys:String}">
                                        <sys:String>Minimize</sys:String>
                                        <sys:String>Maximize</sys:String>
                                    </x:Array>
                                </DataGridComboBoxColumn.ItemsSource>
                            </DataGridComboBoxColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- Constraints -->
                <TabItem Header="Constraints">
                    <DataGrid x:Name="ConstraintsGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False">

                        <DataGrid.Columns>



                            <DataGridComboBoxColumn x:Name="LeftVariableColumn"
                                                    Header="Left Variable"
                                                    SelectedItemBinding="{Binding LeftSide, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="120"/>

                            <DataGridComboBoxColumn Header="Operator"
                                                    SelectedItemBinding="{Binding Operator, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="80">
                                <DataGridComboBoxColumn.ItemsSource>
                                    <x:Array Type="{x:Type sys:String}">
                                        <sys:String>&lt;</sys:String>
                                        <sys:String>&lt;=</sys:String>
                                        <sys:String>&gt;</sys:String>
                                        <sys:String>&gt;=</sys:String>
                                        <sys:String>==</sys:String>
                                    </x:Array>
                                </DataGridComboBoxColumn.ItemsSource>
                            </DataGridComboBoxColumn>

                            <DataGridTextColumn Header="Right side"
                                                Binding="{Binding RightSide, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="80"/>


                            <DataGridTextColumn Header="Description"
                                                Binding="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="*"/>

                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

            </TabControl>
        </Grid>
    </Grid>
</Window>